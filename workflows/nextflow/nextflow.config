// Nextflow configuration for the Vedette cohort CNV pipeline

params {
    // Pipeline steps (prefix of: call, filter, merge, genotype, cohort, ped)
    steps = ['call', 'filter']

    // Inputs
    manifest = ""            // vedette manifest TSV (required)
    pedigree = ""            // 6-column pedigree TSV (required for step 'ped')
    outdir = "results"

    // Vedette
    vedette_bin = "/pasteur/helix/projects/ghfc_wgs/Divers/Alex/Software/CNV/.mamba/envs/vedette/bin/vedette"
    vedette_config = "/pasteur/helix/projects/ghfc_wgs/Divers/Alex/Software/CNV/configs/ghfc.toml"
    resources_dir = "/pasteur/helix/projects/ghfc_wgs/Divers/Alex/Software/CNV/resources"
    fasta = "/pasteur/helix/projects/ghfc_wgs/references/GRCh38/chr/GRCh38.fasta"

    // Optional inputs
    pon = ""                 // panel of normals (.zarr)
    // v5n = v5 estimators with wave_score neutralized (v5 flooded genomes with
    // wave >= ~0.12 with PASS calls); operating threshold SQ>=5, see configs/ghfc.toml
    model_dir = "/pasteur/helix/projects/ghfc_wgs/Divers/Alex/Software/CNV/models/v5n"
    artifact_bed = ""        // recurrent-artifact BED
    contigs = []             // restrict calling to these contigs (smoke tests)
    cohort_name = ""         // display name in the HTML report
    // published calls to re-filter when --steps starts at 'filter' (model update)
    calls_dir = ""
    // reference cohort VCF for family runs: REF_AF/REF_CARRIER_FRAC annotation
    // and the CommonRef flag (sites carried by >=50 % of that cohort). Point it
    // at the latest large-cohort cohort.vcf.gz; empty = no annotation
    known_sites = ""
    // per-family VCF workspaces in the report: fine for family runs, rescans
    // the cohort VCF once per family — disable on 1000+-family cohorts
    family_workspaces = true
    // families/<FID>/events.html: all DEL/DUP of the family in one page with
    // chromosome/type filters, genes + NDD impact + per-member GT:GQ:SQ —
    // family runs only
    family_events = false
    // PASS-only events pages: mandatory at cohort scale (non-PASS artifacts
    // are carried by nearly every family — 140 MB pages otherwise)
    events_pass_only = false
    // chromosomal-scale mosaic CNVs (vedette mosaic) before the report: QC
    // alert on family rows + "Mosaïques chromosomiques" table
    mosaic = true
    // sample-ID prefixes of older, lower-quality genomes: no sub-threshold rows
    // for them in the report (IGV review 2026-10-13: 1/10 true on IP genomes)
    low_quality_prefixes = "IP"
    // tabix-indexed Ensembl GFF for the gene column of report tables
    genes_gff = "/pasteur/helix/projects/ghfc_wgs/references/GRCh38/clinsv/refdata-b38/annotation/Homo_sapiens.GRCh38.99.gff.gz"
    // GeneTrek NDD gene tiers for the impact score of report tables
    ndd_tsv = "/pasteur/helix/projects/ghfc_wgs/Divers/Alex/Software/CNV/genetrek-data-2026-09-15.tsv"
    // repeat-context masks shown per event on the family events pages
    segdup_bed = "/pasteur/helix/projects/ghfc_wgs/references/GRCh38/clinsv/refdata-b38/tracks/GRCh38GenomicSuperDup.bed.gz"
    lcr_bed = "/pasteur/helix/projects/ghfc_wgs/references/GRCh38/selfchain-LCR.hg38.bed"

    // Outputs are hardlinked from the work dir by default (same filesystem);
    // switch to 'copy' when publishing across filesystems
    publish_mode = "link"

    // Resource ceilings
    max_memory = '460.GB'
    max_cpus = 95
    max_time = '240.h'
}

process {
    cpus = 1
    memory = '4.GB'
    time = '24.h'

    errorStrategy = 'retry'
    maxRetries = 2

    withName: 'VEDETTE_CALL' {
        cpus = 8
        memory = { 24.GB * task.attempt }
        // junction-dense genomes can spend hours in hidden-split recovery:
        // scale walltime with the attempt instead of failing three times at 12h
        time = { 12.h * (2 ** (task.attempt - 1)) }
        maxRetries = 3
    }
    withName: 'VEDETTE_FILTER' {
        cpus = 2
        memory = { 8.GB * task.attempt }
    }
    withName: 'VEDETTE_MERGE' {
        cpus = 2
        memory = { 16.GB * task.attempt }
    }
    withName: 'VEDETTE_GENOTYPE' {
        cpus = 2
        memory = { 8.GB * task.attempt }
    }
    withName: 'VEDETTE_COHORT_FILTER' {
        cpus = 2
        memory = { 16.GB * task.attempt }
    }
    withName: 'VEDETTE_PED' {
        cpus = 1
        memory = { 8.GB * task.attempt }
    }
    withName: 'VEDETTE_MOSAIC' {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = '1.h'
    }
    withName: 'VEDETTE_REPORT' {
        cpus = 1
        // genotype matrices + pysam decode overhead: the 528k x 2670 v5 cohort
        // was OOM-killed at 24 GB while reading the VCF — start at 48 GB
        memory = { 48.GB * task.attempt }
        time = '12.h'
    }
}

executor {
    name = 'slurm'
    queueSize = 200
    submitRateLimit = '10 sec'
    pollInterval = '30 sec'
}

profiles {
    // local execution (smoke tests)
    local {
        process.executor = 'local'
        executor.name = 'local'
        params.max_cpus = 8
        params.max_memory = '32.GB'
    }

    // GHFC lab partition
    slurm {
        process.executor = 'slurm'
        process.clusterOptions = '-p ghfc --qos=ghfc'
    }

    // general-purpose partition (fallback; long queue)
    slurm_common {
        process.executor = 'slurm'
        process.clusterOptions = '-p common'
    }
}

manifest {
    name = 'vedette-nf'
    author = 'Alexandre Mathieu (GHFC, Institut Pasteur)'
    description = 'Vedette cohort CNV calling: call, filter, merge, genotype, cohort metrics, pedigree'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.10'
    version = '0.1.0'
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/report.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/reports/trace.txt"
}
